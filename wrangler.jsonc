{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixly-website",
  "compatibility_date": "2026-07-21",
  "main": "worker.js",
  "workers_dev": true,
  "routes": ["www.get-mixly.app/*"],
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "vars": {
    "SHARE_MIX_FUNCTION_URL": "https://snljkpgmtrhaclsmmfdt.supabase.co/functions/v1/share-mix"
  }
}
